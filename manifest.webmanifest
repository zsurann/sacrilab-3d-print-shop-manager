{
  "name": "Sacrilab 3D Print Shop Manager",
  "short_name": "Sacrilab",
  "description": "Selezione automatica dei modelli 3D più vendibili da MakerWorld e pubblicazione su Telegram.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
